# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Unrelated project folder living inside this directory
/betterflow-hindi-streaming-ctc/

# Redundant duplicate of models/indic_translate/ (only used by throwaway
# Python test scripts in models/test/, unzip locally if needed).
/models/model.zip

# Gradle build output (redirected here by android/build.gradle.kts).
/android/build/

# Python venv for the ASR bundle (models/ASR Model/venv).
venv/

# Generated at build time by copyCorrectOrtNativeLibs in
# android/app/build.gradle.kts (copied from the sherpa_onnx plugin's own
# pub-cache jniLibs so it isn't left stale/checked in).
/android/app/src/main/jniLibs/

# CTranslate2-format duplicate of the Hindi->Santali MT model, unused by
# models/SantaliVoice/app.py and not loadable by Flutter anyway (we already
# ship the ONNX version). 286MB, exceeds GitHub's 100MB hard limit.
/models/SantaliVoice/model/indictrans2_sat_int8_ct2.tar.gz

# Generated sample output from running models/SantaliVoice/app.py locally,
# not source material.
/models/SantaliVoice/output/

# Generated sample output from running models/HindiTTS/app.py locally, not
# source material (same rule as models/SantaliVoice/output/ above).
/models/HindiTTS/output/

# Byte-for-byte duplicate of models/indic_translate/ (verified via SHA-256 —
# every .onnx/.onnx.data/tokenizer file matches exactly; see
# HindiSantaliMtService's doc comment). 372MB of redundant tracked content.
/models/SantaliHindiTranslation/

# Claude Code's local scheduled-task lock file — runtime state, not project
# content.
.claude/scheduled_tasks.lock
